# Kopiera den här filen till keystore.properties och fyll i dina värden.
# keystore.properties är gitignorerad — committa den ALDRIG.
#
# Skapa en upload keystore (kör EN gång på Mac):
#
#   keytool -genkeypair \
#     -v \
#     -storetype PKCS12 \
#     -keystore vindkollen-upload.jks \
#     -alias vindkollen \
#     -keyalg RSA \
#     -keysize 2048 \
#     -validity 10000
#
# Spara vindkollen-upload.jks på ett säkert ställe (utanför repot).
# Ladda upp den i Google Play Console → App signing → Upload key certificate.
# Google signerar sedan den faktiska release-APK:n med sin egen nyckel.

storeFile=/Users/dittnamn/nycklar/vindkollen-upload.jks
storePassword=ditt-lösenord
keyAlias=vindkollen
keyPassword=ditt-nyckellösenord
