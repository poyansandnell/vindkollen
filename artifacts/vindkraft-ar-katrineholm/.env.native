# Native-byggkonfiguration (Capacitor iOS/Android).
# Dessa värden byggs in i dist-native vid `pnpm native:build`.
#
# VITE_API_BASE_URL — bas-URL för live-API-anrop från den inbyggda appen.
# Pekar på den deployade produktionsmiljön (windscope.live) — alltid tillgänglig,
# oberoende av om Replit dev-servern är aktiv eller i viloläge.
#
# Verifierad endpoint (returnerar HTTP 200):
#   https://windscope.live/api/wind/project-areas?minLat=55&maxLat=70&minLng=10&maxLng=25
#
VITE_API_BASE_URL=https://windscope.live
#
# VITE_PUBLIC_APP_URL — används för delningslänkar och för att avgöra om
# `openSverigekartan()` ska navigera internt (ej satt) eller öppna extern
# webbläsare (satt). Nu satt till produktions-URL:en eftersom appen har
# en stabil publik adress.
#
VITE_PUBLIC_APP_URL=https://katrineholm.replit.app
